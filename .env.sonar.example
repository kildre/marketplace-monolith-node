# SonarQube Environment Variables
# Copy this file to .env.sonar and fill in your actual token
# Load with: source .env.sonar

# SonarQube Authentication Token
# Get your token from: https://sonarqube.cdao.us/account/security
export SONAR_TOKEN=your_token_here

# Optional: Override default settings
export SONAR_HOST_URL=https://sonarqube.cdao.us
# SONAR_PROJECT_KEY=tenant-metrostar-advana-marketplace-monolith-node
