{
    "name": "advana-marketplace-monolith",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "db:migrate": "sequelize db:migrate",
        "db:migrate:undo": "sequelize db:migrate:undo",
        "db:seed": "sequelize db:seed:all",
        "db:seed:undo": "sequelize db:seed:undo:all",
        "test": "jest --testPathPatterns=\"src/test/.*\\.test\\.(ts|tsx)$\"",
        "unitTest": "jest --testPathPatterns=\"src/test/unit/.*\\.test\\.(ts|tsx)$\""
    },
    "dependencies": {
        "@advana/redis-client": "4.4.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^16.4.7",
        "express": "4.21.2",
        "express-actuator": "^1.8.4",
        "morgan": "^1.10.1",
        "pg": "^8.13.1",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.7",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "ts-parse-database-url": "^1.0.3",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-proposal-decorators": "^7.28.0",
        "@babel/plugin-transform-class-static-block": "^7.28.3",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-typescript": "^7.27.1",
        "@types/express-actuator": "^1.8.3",
        "@types/jest": "^30.0.0",
        "@types/morgan": "^1.9.10",
        "@types/node": "^22.1.0",
        "@types/swagger-ui-express": "^4.1.8",
        "babel-jest": "^30.1.2",
        "jest": "^30.1.3",
        "sequelize-cli": "^6.6.3",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.5",
        "typescript": "^5.5.4"
    }
}
