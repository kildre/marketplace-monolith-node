{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "allowImportingTsExtensions": false
  },
  "exclude": [".next/**/*", "node_modules", "src/app/**/*", "**/*.test.ts", "**/*.spec.ts"],
  "include": ["index.ts", "src/**/*.ts"]
}
